# Target-specific build configurations generated by `cargo xtask ffmpeg-manifest`.
# Collapse them by default in GitHub diffs. Files such as config.h contain
# thousands of lines and are not intended for manual review.
mini-ffmpeg-sys/FFmpeg_build/** linguist-generated=true

# Keep build manifests expanded: they contain changes worth reviewing, such as
# the target and additions or removals of translation units.
mini-ffmpeg-sys/FFmpeg_build/*/cinrs_manifest.toml -linguist-generated
